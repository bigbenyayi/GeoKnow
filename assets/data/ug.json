  {
    "locationUrl": null,
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/world_map_because_i_dont_recognize_any_other_country.png",
    "body": "Uganda has <b>very limited coverage</b>, mostly in <b>Kampala</b>, <b>Entebbe</b>, and various <b>national parks</b>. The guide is structured into two sections: Kampala and the National Parks."
  },
  {
    "locationUrl": "https://goo.gl/maps/wqNR69aJPAuCozGF6",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_leftdrive.png",
    "body": "Uganda drives on the <b>left-hand side</b> of the road."
  },
  {
    "locationUrl": null,
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/Uganda_License_Plate.png",
    "body": "Uganda uses <b>white front</b> license plates and <b>yellow rear</b> plates, which can be long or tall."
  },
  {
    "locationUrl": "https://www.google.com/maps/@0.3498996,32.5710695,3a,75y,195.77h,54.94t/data=!3m7!1e1!3m5!1s-4VBJRsL2rRxstp5SXmUJg!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3D-4VBJRsL2rRxstp5SXmUJg%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D254.88336%26pitch%3D0%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/Kampala_Car_3.png",
    "body": "The Kampala Google car is a unique <b>white, boxy</b> vehicle with <b>square side mirrors</b>, found only in and around the city."
  },
  {
    "locationUrl": null,
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kampalalook.png",
    "body": "Kampala is a <b>busy city</b> with many signs, narrow <b>unpaved roads</b>, and small one-story houses often surrounded by <b>tall walls</b> with barbed wire."
  },
  {
    "locationUrl": "https://www.google.com/maps/@0.1468879,32.5297128,3a,75y,338.81h,65t/data=!3m6!1e1!3m4!1sqMAl7D1hZ8dN1vFCwCPzXQ!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kampalasoil.png",
    "body": "The soil in Kampala is typically very <b>red</b>, and even paved roads can have a <b>red, purple, or pink tinge</b>."
  },
  {
    "locationUrl": "https://www.google.se/maps/@0.2428246,32.5355652,3a,76.9y,106.63h,81.39t/data=!3m6!1e1!3m4!1sQFrzMt6TQf_biWCplYQGIg!2e0!7i13312!8i6656!5m1!1e4",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kampalahills.png",
    "body": "Kampala is a very <b>hilly city</b>, so expect to see elevation changes and hills."
  },
  {
    "locationUrl": "https://goo.gl/maps/hHeruNjdepMCeDrr5",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/van.png",
    "body": "Look for <b>taxi buses</b> with a <b>blue blocky pattern</b> on the sides, which are a good clue for Kampala."
  },
  {
    "locationUrl": "https://goo.gl/maps/18yH3t8dKF8ZR1JC8",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/corrupt_politician.png",
    "body": "Kampala's <b>city centre</b> is more affluent and built-up, with paved roads, <b>black-and-white curbs</b>, and multi-story buildings."
  },
  {
    "locationUrl": "https://www.google.se/maps/@0.0697961,32.456586,3a,75y,51.83h,89.9t/data=!3m6!1e1!3m4!1ssn4GnJoAp4ZPKw6tD7Lerg!2e0!7i13312!8i6656!5m1!1e4",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_entebbe.png",
    "body": "<b>Entebbe</b>, southwest of Kampala, is <b>emptier</b> with more <b>greenery</b>, fancier houses, and more <b>street signs</b> than the capital."
  },
  {
    "locationUrl": "https://www.google.com/maps/@-0.142312,29.9099473,2a,49y,94.87h,57.14t/data=!3m7!1e1!3m5!1smg06gH9Aq50PGuMbTnjeew!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3Dmg06gH9Aq50PGuMbTnjeew%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D200%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_npcar.png",
    "body": "The Ugandan national park Street View car is similar to the Kampala car but has a <b>black bar</b> on the front, though it's not always visible."
  },
  {
    "locationUrl": "https://www.google.se/maps/@3.6992646,33.7449487,2a,75y,328.42h,84.83t/data=!3m7!1e1!3m5!1sTFCYaDTLxPXPWVwyPOpy3Q!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3DTFCYaDTLxPXPWVwyPOpy3Q%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D140%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kidepo.png",
    "body": "<b>Kidepo Valley National Park</b>, in the northeast, is a large savannah with <b>mountains</b> visible in most directions, especially a recognizable range to the <b>east</b>."
  },
  {
    "locationUrl": "https://www.google.com/maps/@3.8103403,33.7022159,2a,90y,318.9h,95.62t/data=!3m6!1e1!3m4!1s-7WJKDDgJ3jSGLcyjgQ8Iw!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kidepo2.png",
    "body": "The southern half of the north road in Kidepo is more <b>forested</b>, which can obscure views of the mountains."
  },
  {
    "locationUrl": "https://www.google.com/maps/@3.9240715,33.7007798,2a,75y,27.38h,88.57t/data=!3m7!1e1!3m5!1sOc9XwgplDXlvkyBSJaWWVg!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3DOc9XwgplDXlvkyBSJaWWVg%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D200%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kidepo3.png",
    "body": "The northern half of the north road in Kidepo is a savannah, easily recognized by the <b>wide mountain</b> to the north."
  },
  {
    "locationUrl": "https://www.google.com/maps/@2.2692476,31.4238286,2a,75y,66.01h,84.18t/data=!3m7!1e1!3m5!1sIZ-FMmnaAVuiJ-DYZ7YNUQ!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3DIZ-FMmnaAVuiJ-DYZ7YNUQ%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D300%26pitch%3D0%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_murchison.png",
    "body": "<b>Murchison Falls National Park</b>, by Lake Albert, has low <b>dirt barriers</b> along its roads. It features a savannah in the west and small trees in the east, with no nearby mountains except for a distant range to the west."
  },
  {
    "locationUrl": "https://www.google.com/maps/@2.3703472,31.5470799,2a,55.4y,81.53h,103.1t/data=!3m6!1e1!3m4!1sDmtEkqQ1BBcP9Q52oWchGg!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_murchisonpalms.png",
    "body": "Seeing these distinctive <b>palms</b> in Uganda is a strong clue for the northern part of <b>Murchison Falls National Park</b>."
  },
  {
    "locationUrl": "https://www.google.se/maps/@0.4726127,30.3663349,2a,75y,339.27h,89.61t/data=!3m7!1e1!3m5!1sh9Lhm5ZmuHrLGDrTuXa6pA!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3Dh9Lhm5ZmuHrLGDrTuXa6pA%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D120%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kibalebigroad.png",
    "body": "<b>Kibale National Park</b> features a very <b>wide dirt road</b> through a dense tropical forest, the widest of its kind in Uganda outside of Kampala."
  },
  {
    "locationUrl": "https://www.google.com/maps/@0.4746137,30.4322873,2a,75y,28.76h,82.9t/data=!3m7!1e1!3m5!1shFjA4GnvmpAv9rRqyvttxw!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3DhFjA4GnvmpAv9rRqyvttxw%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D340%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kibalesmallroad.png",
    "body": "Kibale also has coverage on a <b>small, flat forest road</b> through a dense but not overly dark forest."
  },
  {
    "locationUrl": "https://www.google.se/maps/@0.4384565,30.3985362,2a,75y,223.03h,95.52t,359.99r/data=!3m6!1e1!3m4!1skGODPHxsDHAEcgk2FvOv2w!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_kibaletinypath.png",
    "body": "The third type of coverage in Kibale is on <b>tiny forest paths</b>, which are somewhat dark with patches of sunlight."
  },
  {
    "locationUrl": "https://www.google.com/maps/@-0.6040777,30.9634427,2a,90y,115.89h,95.73t/data=!3m6!1e1!3m4!1sSRk2LeNW1plkkubARAm4jw!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_mburo.png",
    "body": "<b>Lake Mburo National Park</b> has the <b>driest coverage</b> in Uganda, with dried-out grass and dry-looking vegetation. The area is hilly but not mountainous."
  },
  {
    "locationUrl": "https://www.google.com/maps/@0.8534425,30.1477759,2a,80.9y,34.65h,118.17t,-4.83r/data=!3m7!1e1!3m5!1sV2R8NQsCZPYjVGqmCdh81A!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3DV2R8NQsCZPYjVGqmCdh81A%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D260%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_semuliki.png",
    "body": "<b>Semuliki National Park</b> has coverage on two parallel forest paths. The area is very humid, and you can often see <b>drops of water</b> on the camera lens."
  },
  {
    "locationUrl": "https://www.google.se/maps/@1.1700367,34.4126182,2a,90y,61.41h,107.49t/data=!3m7!1e1!3m5!1s3tLH-0iWGRqWQc7VxgowTQ!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3D3tLH-0iWGRqWQc7VxgowTQ%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D280%26pitch%3D-10%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_mtelgonwest.png",
    "body": "<b>Mount Elgon National Park</b> has a forest path with a <b>steep upward slope</b> to the east and very <b>dark red dirt</b>."
  },
  {
    "locationUrl": "https://www.google.se/maps/@1.1456799,34.5164884,2a,90y,49.39h,86.83t,360r/data=!3m6!1e1!3m4!1sTJuSuufltD3ApsiTiYdVxQ!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_mtelgoneast.png",
    "body": "The eastern path in Mount Elgon is recognizable by small <b>palm-like trees</b> on an open, hilly field, and a man in green with a <b>rifle</b> following the photographer."
  },
  {
    "locationUrl": "https://www.google.com/maps/@-0.0816028,29.9616451,2a,90y,57.35h,88.95t/data=!3m7!1e1!3m5!1sWd4mGA1RXVPs6RYm9F5kYQ!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3DWd4mGA1RXVPs6RYm9F5kYQ%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D300%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_queenlizdirt.png",
    "body": "<b>Queen Elizabeth National Park</b> is one of the few places in Uganda with <b>non-red dirt</b>; it's typically <b>brown or greyish</b>."
  },
  {
    "locationUrl": "https://www.google.se/maps/@-0.0313222,30.0595702,2a,72.3y,270.47h,92.22t/data=!3m6!1e1!3m4!1sa6Qwr2gzdXys31BZrUBX6w!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_queenlizcactus.png",
    "body": "In addition to the brown dirt, the park has <b>large, tree-like cacti</b> with many upward-pointing branches."
  },
  {
    "locationUrl": "https://www.google.se/maps/@-0.060369,29.981598,2a,75y,243.71h,83.45t/data=!3m7!1e1!3m5!1swr4vLqO_s8n2kmJgL2m1KQ!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fpanoid%3Dwr4vLqO_s8n2kmJgL2m1KQ%26cb_client%3Dmaps_sv.tactile.gps%26w%3D203%26h%3D100%26yaw%3D260%26pitch%3D-20%26thumbfov%3D100!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_queenlizcrater.png",
    "body": "The northern part of the park features large, <b>water-filled craters</b>, which are unique to this area in Uganda."
  },
  {
    "locationUrl": "https://www.google.com/maps/@-0.0554624,30.0180458,2a,90y,337.45h,86.6t/data=!3m6!1e1!3m4!1sCYe8KvXC21kr3jgAFpL5bg!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_queenlizpavedroad.png",
    "body": "The <b>only paved road</b> outside Kampala is here, lacking the typical red tinge. It has white outer lines, a yellow middle line, an eastern power line, and hills to the north."
  },
  {
    "locationUrl": "https://www.google.com/maps/@-0.1439778,29.8856274,2a,75y,97.44h,88.41t/data=!3m6!1e1!3m4!1sb-qMxSOPmJTrare-4FKh0Q!2e0!7i13312!8i6656",
    "imageUrl": "https://www.plonkit.net/images/resize/600/80/uganda/ug_queenlizkatwe.png",
    "body": "<b>Katwe village</b> is the only significant settlement with Street View coverage outside of Kampala."
  }
]
